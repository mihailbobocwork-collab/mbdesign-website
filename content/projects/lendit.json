    {
      "id": "section-6a4c2693c75c754a4950a5c0",
      "kind": "content",
      "columns": [
        {
          "start": 1,
          "span": 6,
          "blocks": [
            {
              "type": "image",
              "image": "/assets/projects/lendit/d4b167fbeb28ef.webp",
              "alt": "Lendit — Prototype · 13",
              "width": 786,
              "height": 1701,
              "device": "mobile",
              "variants": [
