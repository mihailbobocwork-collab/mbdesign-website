    {
      "id": "section-6a4d6be46aad411f8522f41d",
      "kind": "content",
      "columns": [
        {
          "start": 1,
          "span": 6,
          "blocks": [
            {
              "type": "image",
              "image": "/assets/projects/lendit/51333deff91c73.webp",
              "alt": "Lendit — Experience 2 - Trust & book · 19",
